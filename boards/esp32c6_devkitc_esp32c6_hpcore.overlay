#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    /*zephyr,user {
        io-channels = <&i2c_adc 0>;
    };*/
    chosen {
        zephyr,console = &uart0;
    };
    aliases {
        rtc = &ds3231_rtc;
        ledok = &led0;
        ledbusy = &led1;
        fluxsensor = &ads1115;
        btnstart = &button0;
        boardt = &sht35;
    };
    leds {
        compatible = "gpio-leds";

        led0: led_0 {
            gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
            label = "LED 0";
        };
        led1: led_1 {
            gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
            label = "LED 1";
        };
    };
    buttons {
        compatible = "gpio-keys";
        status = "okay";
        debounce-interval-ms = <100>;

        button0: button_0 {
            gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            zephyr,code = <INPUT_KEY_0>;
            label = "START button";
        };
    };
};


&pinctrl {
	spim2_custom: spim2_custom {
		group1 {
			pinmux = <SPIM2_MISO_GPIO21>,
				 <SPIM2_SCLK_GPIO20>,
				 <SPIM2_CSEL_GPIO18>;
		};

		group2 {
			pinmux = <SPIM2_MOSI_GPIO19>;
			output-low;
		};
	};
};

&i2c0 {
    status = "okay";

    /*i2c_adc: ads1115@48 {
        status = "okay";
        compatible = "ti,ads1115";
        reg = <0x48>;
        #io-channel-cells = <1>;
        #address-cells = <1>;
        #size-cells = <0>;
        channel@0 {
            reg = <0>;
            zephyr,gain = "ADC_GAIN_2";
            zephyr,reference = "ADC_REF_INTERNAL";
            zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
            zephyr,differential;
            zephyr,input-positive = <0>;
            zephyr,input-negative = <3>;
            zephyr,resolution = <16>;
        };
    }; */
    ads1115: ads1115@48 {
        compatible = "ti,ads1115sensor";
        reg = <0x48>;
        status = "okay";
    };

    ds3231: ds3231@68 {
        compatible = "maxim,ds3231-mfd";
        reg = <0x68>;
        status = "okay";

        ds3231_sensor: ds3231_sensor {
                compatible = "maxim,ds3231-sensor";
                status = "okay";
        };

        ds3231_rtc: ds3231_rtc {
                compatible = "maxim,ds3231-rtc";
                status = "okay";

                isw-gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
                //freq-32khz-gpios = <&gpio0 33 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };

    };
    sht35: sht35@44 {
        compatible = "sensirion,sht3xd";
        reg = <0x44>;
        status = "okay";
    };
};

&spi2 {
        status = "okay";
        pinctrl-0 = <&spim2_custom>;
        cs-gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;

        sdhc0: sdhc@0 {
                compatible = "zephyr,sdhc-spi-slot";
                reg = <0>;
                status = "okay";
                mmc {
                    compatible = "zephyr,sdmmc-disk";
                    disk-name = "SD";
                    status = "okay";
                };
                spi-max-frequency = <24000000>;
        };
};
